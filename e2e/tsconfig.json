/* The Playwright suite runs in Node, not the browser: it needs node types and
   CommonJS, which the Angular tsconfig deliberately does not provide.
   Playwright transpiles specs itself with esbuild (no type checking) on Node
   22, so this file is for editor support and for
   `npx tsc --noEmit -p e2e/tsconfig.json`, which is expected to pass.
   moduleResolution is node10 because the parent's "bundler" is not allowed
   with module commonjs (TS5095). lib is es2022 because the specs use
   Array.prototype.at, and @types/node no longer shims it from version 25. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/e2e",
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "esModuleInterop": true,
    "sourceMap": false,
    "strict": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"],
  "exclude": []
}
